PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=giri_darshan_db

# Generate a unique random value containing at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h

# Comma-separated frontend origins. Add the port used by your static server.
CORS_ORIGIN=http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5500,http://localhost:5500

